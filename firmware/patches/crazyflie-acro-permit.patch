+static bool isAcroPermitActiveAtTick(const uint32_t currentTick) {
+  const uint32_t expiry = supervisorMem.acroPermitUntilTick;
+  return expiry != 0 && (int32_t)(expiry - currentTick) > 0;
+}
+
+bool supervisorIsAcroPermitActive(void) {
+  return isAcroPermitActiveAtTick(xTaskGetTickCount());
+}
+
+bool supervisorRequestAcroPermit(const uint16_t durationMs) {
+  if (!supervisorIsFlying() || durationMs == 0 ||
+      durationMs > MAX_ACRO_PERMIT_DURATION_MS) {
+    return false;
+  }
+
+  supervisorMem.initialTumbleTick = 0;
+  supervisorMem.acroPermitUntilTick = xTaskGetTickCount() + M2T(durationMs);
+  return true;
+}
